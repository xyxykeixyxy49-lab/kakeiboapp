# このファイルは「見本」です。コピーして .env という名前で保存し、値を入れてください。
# .env は .gitignore に入っているので GitHub には上がりません。
# (段階2以降で使います)

# 管理者ログイン用パスワード
ADMIN_PASSWORD=

# Notion
NOTION_TOKEN=
NOTION_PROJECTS_DB_ID=
NOTION_NODES_DB_ID=
NOTION_COMMENTS_DB_ID=

# Google ドライブ
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
