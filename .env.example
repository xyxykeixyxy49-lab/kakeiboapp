# このファイルは「見本」です。コピーして .env.local という名前で保存し、値を入れてください。
# .env.local は .gitignore に入っているので GitHub には上がりません。
# Vercelでは「Settings → Environment Variables」に同じ名前で登録します。

# ---- 段階2 ----
# 管理者ログイン用パスワード(自分で決める。長めがおすすめ)
ADMIN_PASSWORD=

# Notionのインテグレーションの「シークレット」(ntn_ または secret_ で始まる文字列)
NOTION_TOKEN=

# NotionのデータソースID(空なら作成済みの「LINE構成デザイナー(アプリ用データ)」を使う)
NOTION_PROJECTS_DS_ID=
NOTION_NODES_DS_ID=
NOTION_COMMENTS_DS_ID=

# ---- 段階3以降 ----
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
